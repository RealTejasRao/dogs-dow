# Public canonical URL. Set to your real HTTPS domain before launch.
NEXT_PUBLIC_SITE_URL=https://dogsanddow.com
# Optional HTML verification token from Google Search Console (DNS verification also works).
GOOGLE_SITE_VERIFICATION=
# Sanity: public dataset contains publishable content only; tokens are server-only.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=
# Company enquiries: Formspree ID. Set a verified notification recipient in Formspree Workflow.
# Formshield spam filtering must stay enabled. Turnstile is optional; if used, configure matching keys in Formspree too.
NEXT_PUBLIC_FORMSPREE_ID=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Student applications use a separate Formspree inbox via the server-side /api/apply route.
RECRUITMENT_FORMSPREE_ID=
TURNSTILE_SECRET_KEY=
# Optional real, monitored fallback inbox. Never invent an address.
NEXT_PUBLIC_CONTACT_EMAIL=
# Cloudinary: unsigned uploads must remain disabled.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Monitoring; analytics disabled locally and on previews by default.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_ENABLE_ANALYTICS=false
